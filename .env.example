# -----------------------------------------------------------------------------
# DYKESTRATA SERVICES LIMITED — environment variables (EXAMPLE ONLY)
# Copy to `.env` for local development. NEVER commit the real `.env` file.
# In production (Cloudflare Pages) set these in the dashboard:
#   Settings → Environment variables  (mark secrets as "Encrypted")
# -----------------------------------------------------------------------------

# --- Contact form email delivery (Resend) ------------------------------------
# Get an API key from https://resend.com — required for the form to send email.
RESEND_API_KEY=

# The inbox that receives website enquiries.
CONTACT_TO_EMAIL=

# A verified sender address on your Resend domain, e.g. website@yourdomain.com
CONTACT_FROM_EMAIL=

# --- Optional analytics (leave blank to disable) -----------------------------
# Only loaded if also enabled in assets/js/config.js. Add the provider's domain
# to _headers (script-src / connect-src) before enabling.
PLAUSIBLE_DOMAIN=
GA4_MEASUREMENT_ID=
